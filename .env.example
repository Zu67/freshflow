# Copy to .env. The web app, the CLI and the container all read this file.
# A variable already set in your shell wins over this file.
#
# You need one model backend. Either set an API key below, or leave both keys
# empty and use Claude Code or Codex, signed in with your subscription.

# Anthropic API
ANTHROPIC_API_KEY=

# OpenAI API
OPENAI_API_KEY=

# Optional: choose a backend instead of the automatic order
# (anthropic, openai, claude-cli, codex-cli).
# FRESHFLOW_BACKEND=claude-cli

# Optional model override. API defaults: claude-sonnet-5, gpt-5.5. The CLIs use
# their own default.
# FRESHFLOW_MODEL=

# MERIDIAN_EXTRACT=./meridian-extract
